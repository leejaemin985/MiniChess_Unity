<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <UnityEditorPath Condition="'$(UnityEditorPath)' == ''">C:/Program Files/Unity/Hub/Editor/2022.3.55f1/Editor</UnityEditorPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Game/*.cs" Link="Game/%(Filename)%(Extension)" />
    <Compile Include="../../Assets/Scripts/Unit/*.cs" Link="Unit/%(Filename)%(Extension)" />
    <Compile Include="../../Assets/Scripts/Board/*.cs" Link="Board/%(Filename)%(Extension)" />
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityEditorPath)/Data/Managed/UnityEngine/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(UnityEditorPath)/Data/Managed/UnityEngine/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(UnityEditorPath)/Data/Managed/UnityEngine/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(UnityEditorPath)/Data/Managed/UnityEngine/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(UnityEditorPath)/Data/Managed/UnityEngine/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
