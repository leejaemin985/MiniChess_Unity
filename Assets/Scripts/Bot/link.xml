<!--
  IL2CPP 코드 제거(Managed Stripping)에서 봇이 리플렉션으로 읽는 타입을 지키는 설정.
  StateHasher 가 Core 스냅샷(GameSnapshot 과 그 안의 값 타입들)의 공개 속성/필드를 리플렉션으로 훑어 판 해시를 만든다.
  코드에서 직접 쓰지 않는 속성이 제거되면 기기에서만 해시가 달라지거나("해시할 공개 멤버가 없는 타입" 예외) 같은 판 합치기가 틀어진다.
-->
<linker>
  <assembly fullname="MiniChess.Core">
    <namespace fullname="MiniChess.Core.Snapshots" preserve="all" />
    <type fullname="MiniChess.Core.Common.Position" preserve="all" />
  </assembly>
</linker>
